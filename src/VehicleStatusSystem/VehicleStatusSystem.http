@baseUrl = http://localhost:5129

# 替换为 SQL 查询得到的三个真实 ReminderId
@reminderA = 1
@reminderB = 2
@reminderPublic = 3

### 1. Operator A 查询自己的历史提醒
GET {{baseUrl}}/api/operator/inspection-reminders/1
Authorization: Bearer {{Operator1Token}}

###

### 2. Operator B 越权查询 A 的提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderA}}
Authorization: Bearer {{OperatorBToken}}

###

### 3. Operator B 查询自己的提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderB}}
Authorization: Bearer {{Operator2Token}}
###

### 4. Operator A 越权查询 B 的提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderA}}
Authorization: Bearer {{Operator2Token}}

###

### 5. Admin 查询 A 的提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderA}}
Authorization: Bearer {{AdminToken}}

###

### 6. Admin 查询 B 的提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderB}}
Authorization: Bearer {{AdminToken}}

###

### 7. Operator A 查看公共 Open 提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderPublic}}
Authorization: Bearer {{OperatorAToken}}

###

### 8. Operator B 查看公共 Open 提醒
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderPublic}}
Authorization: Bearer {{OperatorBToken}}

###

### 9. 普通 User 越权
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderA}}
Authorization: Bearer {{UserToken}}

###

### 10. 未登录访问
GET {{baseUrl}}/api/operator/inspection-reminders/{{reminderA}}


