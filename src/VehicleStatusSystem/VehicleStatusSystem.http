Authorization: Bearer {{UserToken}}
Content-Type: application/json

{
  "items": [
    {
      "vehicleId": 1050,
      "startAt": "2026-11-01T06:34:58.8476490Z",
      "endAt": "2026-11-04T06:34:58.8476490Z"
    },
